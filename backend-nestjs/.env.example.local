NODE_ENV=development
PORT=5001
# Isolated local Docker Compose database (docker-compose.local.yml)
DATABASE_URL=postgres://postgres:replace-with-generated-local-password@127.0.0.1:55432/codeskill_local
DATABASE_HOST=127.0.0.1
DATABASE_PORT=55432
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-generated-local-password
DATABASE_NAME=codeskill_local
DATABASE_SSL=false
DB_SYNCHRONIZE=false
DB_POOL_MAX=50
DB_POOL_MIN=5
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=5000
# Must be at least 32 characters and high-entropy
JWT_SECRET=your_secure_random_jwt_secret_must_be_at_least_32_chars_long
JWT_EXPIRE=1h
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=30d

# Redis Configuration (isolated local Docker Compose service)
REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:56379

# OAuth Configurations
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# AWS SES Configuration (For OTP Emails)
AWS_REGION=ap-south-1
AWS_SES_EMAIL=samtipu20016@gmail.com
# Set these to your real keys for local development
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Sandbox / Compilation Configuration
# (Can be left as default for local dev)
SANDBOX_TIMEOUT=10000
SANDBOX_MEMORY_LIMIT=256

# Frontend URL (For CORS and email links)
CLIENT_URL=http://localhost:3000

# Practice pet: use a free OpenRouter coding model for open-ended answers.
# Voice input falls back to on-device Whisper; spoken replies use browser speech synthesis.
# Without an AI key, the pet offers one hint using each problem's public input and examples.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free

# Optional direct DeepSeek fallback when OpenRouter is not configured.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional submission sharding; see docs/submission-sharding.md.
# Configure every API and judge identically after the offline migration.
SUBMISSION_SHARDS=
SUBMISSION_SHARD_POOL_SIZE=5
