# CodeSkill Uptime Kuma & WhatsApp Notification Configuration

# Port to expose Uptime Kuma locally
UPTIME_KUMA_PORT=3001

# WhatsApp Business Cloud API Configuration
# Meta Graph API Token & Phone Number ID (from developers.facebook.com)
WHATSAPP_API_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Configured Alert Recipient Phone Number
RECIPIENT_PHONE_NUMBER=919582277481
